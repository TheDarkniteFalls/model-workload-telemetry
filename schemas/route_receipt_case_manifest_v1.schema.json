{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheDarkniteFalls/model-workload-telemetry/schemas/route_receipt_case_manifest_v1.schema.json",
  "title": "Synthetic route receipt case manifest v1",
  "description": "A strict, digest-bound denominator for deterministic route-receipt conformance reporting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "route_receipt_case_manifest_v1"
    },
    "manifest_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "mode",
        "path",
        "sha256"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mode": {
          "enum": [
            "passive",
            "enforced"
          ]
        },
        "path": {
          "$ref": "#/$defs/nonempty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_id",
        "base_receipt_id",
        "category",
        "primary_finding_code"
      ],
      "properties": {
        "mutation_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_receipt_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "category": {
          "enum": [
            "attempts",
            "final_models",
            "fallback_transitions",
            "quality_status",
            "source_boundaries",
            "safety_boundaries",
            "writes",
            "passive_authority",
            "enforced_false_pass",
            "finalization",
            "contract_robustness"
          ]
        },
        "primary_finding_code": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "ground_truth",
        "receipts",
        "mutations"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ground_truth": {
          "$ref": "#/$defs/artifact"
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/receipt"
          }
        },
        "mutations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mutation"
          }
        }
      }
    }
  }
}
