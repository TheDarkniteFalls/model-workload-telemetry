{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheDarkniteFalls/model-workload-telemetry/schemas/route_receipt_v0.schema.json",
  "title": "Synthetic route receipt v0",
  "description": "A strict, non-executing Phase 1 receipt for synthetic route-attempt reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "case_id",
    "receipt_mode",
    "execution_mode",
    "model_called",
    "network_called",
    "state_mutating",
    "policy_id",
    "candidate_route",
    "actual_route",
    "attempts",
    "final_attempt_id",
    "final_model",
    "completion_status",
    "fallback",
    "quality",
    "writes",
    "finalization",
    "enforcement_status",
    "completion_claim",
    "automatic_route_change",
    "promotion_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "route_receipt_v0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "receipt_mode": {
      "enum": [
        "passive",
        "enforced"
      ]
    },
    "execution_mode": {
      "const": "synthetic_replay"
    },
    "model_called": {
      "const": false
    },
    "network_called": {
      "const": false
    },
    "state_mutating": {
      "const": false
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_route": {
      "$ref": "#/$defs/route"
    },
    "actual_route": {
      "const": "none"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "final_attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "final_model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "completion_status": {
      "enum": [
        "completed_without_fallback",
        "completed_via_fallback",
        "hold"
      ]
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted",
        "used",
        "trigger_attempt_id",
        "trigger_outcome"
      ],
      "properties": {
        "permitted": {
          "type": "boolean"
        },
        "used": {
          "type": "boolean"
        },
        "trigger_attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "trigger_outcome": {
          "oneOf": [
            {
              "$ref": "#/$defs/failed_outcome"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessed_attempt_ids",
        "unassessed_attempts",
        "final_quality_status"
      ],
      "properties": {
        "assessed_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unassessed_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_id",
              "reason"
            ],
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "runtime_failure",
                  "validation_failure",
                  "policy_rejection"
                ]
              }
            }
          }
        },
        "final_quality_status": {
          "enum": [
            "pass",
            "fail",
            "not_assessed"
          ]
        }
      }
    },
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "observed",
        "unexpected"
      ],
      "properties": {
        "expected": {
          "$ref": "#/$defs/empty_string_list"
        },
        "observed": {
          "$ref": "#/$defs/empty_string_list"
        },
        "unexpected": {
          "$ref": "#/$defs/empty_string_list"
        }
      }
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "integrity_verified"
      ],
      "properties": {
        "status": {
          "enum": [
            "finalized",
            "failed"
          ]
        },
        "integrity_verified": {
          "type": "boolean"
        }
      }
    },
    "enforcement_status": {
      "enum": [
        "not_applied",
        "pass",
        "hold"
      ]
    },
    "completion_claim": {
      "enum": [
        "observed_only",
        "auditable_complete",
        "hold"
      ]
    },
    "automatic_route_change": {
      "const": false
    },
    "promotion_decision": {
      "const": "not_promoted"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt_mode": {
            "const": "passive"
          }
        },
        "required": [
          "receipt_mode"
        ]
      },
      "then": {
        "properties": {
          "enforcement_status": {
            "const": "not_applied"
          },
          "completion_claim": {
            "const": "observed_only"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "receipt_mode": {
            "const": "enforced"
          }
        },
        "required": [
          "receipt_mode"
        ]
      },
      "then": {
        "properties": {
          "enforcement_status": {
            "const": "pass"
          },
          "completion_claim": {
            "const": "auditable_complete"
          }
        }
      }
    }
  ],
  "$defs": {
    "route": {
      "enum": [
        "deterministic",
        "fast_small",
        "primary_quality",
        "deep_comparison"
      ]
    },
    "failed_outcome": {
      "enum": [
        "infrastructure_failure",
        "validation_failure",
        "policy_rejected"
      ]
    },
    "empty_string_list": {
      "type": "array",
      "maxItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "ordinal",
        "route",
        "requested_model",
        "responding_model",
        "outcome",
        "failure_stage",
        "quality_status",
        "fallback_from_attempt_id",
        "input_tokens",
        "output_tokens",
        "wall_seconds"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "responding_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "completed",
            "infrastructure_failure",
            "validation_failure",
            "policy_rejected"
          ]
        },
        "failure_stage": {
          "enum": [
            "none",
            "pre_request",
            "request_open",
            "response_stream",
            "validation",
            "policy"
          ]
        },
        "quality_status": {
          "enum": [
            "assessed_pass",
            "assessed_fail",
            "not_assessed_runtime_failure",
            "not_assessed_validation_failure",
            "not_assessed_policy_rejection"
          ]
        },
        "fallback_from_attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
